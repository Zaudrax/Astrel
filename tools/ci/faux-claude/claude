#!/usr/bin/env python3
"""FAUX Claude Code pour l'intégration continue (P2, lot 3) : répond seulement à
ce que demande `tools/check_install.py` (version, état de connexion). Aucun
appel réseau, aucun modèle. Toute autre commande échoue franchement (code 2)."""
import json
import sys

args = sys.argv[1:]
if args[:1] == ["--version"]:
    print("0.0.0 (faux Claude Code pour la CI)")
elif args[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": True, "authMethod": "claude.ai", "subscriptionType": "ci"}))
else:
    print(f"faux claude : commande non simulée {args!r}", file=sys.stderr)
    sys.exit(2)
